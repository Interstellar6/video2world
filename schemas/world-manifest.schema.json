        "evidence_frames": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Frames",
          "type": "array"
        },
        "fidelity_caveat": {
          "anyOf": [
            {
              "$ref": "#/$defs/LocalizedText"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "location": {
          "anyOf": [
            {
              "$ref": "#/$defs/LocalizedText"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        },
        "short": {
          "anyOf": [
            {
              "$ref": "#/$defs/LocalizedText"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "DescriptionEvidence",
      "type": "object"
    },
    "GateRecord": {
      "additionalProperties": false,
      "properties": {
        "metrics": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "string"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Metrics",
          "type": "object"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "report_uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Report Uri"
        },
        "status": {
          "default": "not_tested",
          "enum": [
            "passed",
            "failed",
            "not_tested"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "title": "GateRecord",
      "type": "object"
    },
    "InteractionPolicy": {
      "additionalProperties": false,
      "properties": {
        "collision_enabled": {
          "default": false,
          "title": "Collision Enabled",
          "type": "boolean"
        },
        "double_click_action": {
          "default": "none",
          "enum": [
            "none",
            "spin_360"
          ],
          "title": "Double Click Action",
          "type": "string"
        },
        "drag_action": {
          "default": "none",
          "enum": [
            "none",
            "rotate_yaw"
          ],
          "title": "Drag Action",
          "type": "string"
        },
        "physics_mode": {
          "default": "none",
          "enum": [
            "none",
            "static",
            "kinematic",
            "dynamic"
          ],
          "title": "Physics Mode",
          "type": "string"
        },
        "selectable": {
          "default": false,
          "title": "Selectable",
          "type": "boolean"
        }
      },
      "title": "InteractionPolicy",
      "type": "object"
    },
    "LocalizedText": {
      "additionalProperties": false,
      "properties": {
        "en": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "En"
        },
        "zh": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Zh"
        }
      },
      "title": "LocalizedText",
      "type": "object"
    },
