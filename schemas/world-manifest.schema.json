{
  "$defs": {
    "AssetRef": {
      "additionalProperties": false,
      "properties": {
        "media_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Media Type"
        },
        "provenance": {
          "additionalProperties": true,
          "title": "Provenance",
          "type": "object"
        },
        "role": {
          "minLength": 1,
          "title": "Role",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 1,
          "title": "Size Bytes",
          "type": "integer"
        },
        "status": {
          "default": "candidate",
          "enum": [
            "candidate",
            "validated",
            "rejected"
          ],
          "title": "Status",
          "type": "string"
        },
        "uri": {
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "uri",
        "sha256",
        "size_bytes",
        "role"
      ],
      "title": "AssetRef",
      "type": "object"
    },
    "Bounds2D": {
      "additionalProperties": false,
      "properties": {
        "convention": {
          "default": "pixel-exclusive",
          "enum": [
            "pixel-inclusive",
            "pixel-exclusive"
          ],
          "title": "Convention",
          "type": "string"
        },
        "frame_id": {
          "minLength": 1,
          "title": "Frame Id",
          "type": "string"
        },
        "image_height": {
          "exclusiveMinimum": 0,
          "title": "Image Height",
          "type": "integer"
        },
        "image_width": {
          "exclusiveMinimum": 0,
          "title": "Image Width",
          "type": "integer"
        },
        "xyxy": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Xyxy",
          "type": "array"
        }
      },
      "required": [
        "frame_id",
        "image_width",
        "image_height",
        "xyxy"
      ],
      "title": "Bounds2D",
      "type": "object"
    },
    "Bounds3D": {
      "additionalProperties": false,
      "properties": {
        "frame_id": {
          "minLength": 1,
          "title": "Frame Id",
          "type": "string"
        },
        "maximum": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Maximum",
          "type": "array"
        },
        "minimum": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Minimum",
          "type": "array"
        }
      },
      "required": [
        "frame_id",
        "minimum",
        "maximum"
      ],
      "title": "Bounds3D",
      "type": "object"
    },
    "CoordinateSystem": {
      "additionalProperties": false,
      "properties": {
        "frame_id": {
          "minLength": 1,
          "title": "Frame Id",
          "type": "string"
        },
        "handedness": {
          "enum": [
            "right",
            "left"
          ],
          "title": "Handedness",
          "type": "string"
        },
        "metric_scale": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metric Scale"
        },
        "units": {
          "default": "native",
          "enum": [
            "meters",
            "centimeters",
            "millimeters",
            "native",
            "scene_scale_not_metric"
          ],
          "title": "Units",
          "type": "string"
        },
        "up_axis": {
          "enum": [
            "+X",
            "-X",
            "+Y",
            "-Y",
            "+Z",
            "-Z"
          ],
          "title": "Up Axis",
          "type": "string"
        }
      },
      "required": [
        "frame_id",
        "up_axis",
        "handedness"
      ],
      "title": "CoordinateSystem",
      "type": "object"
    },
    "DescriptionEvidence": {
      "additionalProperties": false,
      "properties": {
        "appearance": {
          "anyOf": [
            {
              "$ref": "#/$defs/LocalizedText"
